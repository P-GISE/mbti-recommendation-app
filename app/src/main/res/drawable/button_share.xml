<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 눌렸을 때 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#48BB78"
                android:endColor="#38A169"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- 기본 상태 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#68D391"
                android:endColor="#48BB78"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>