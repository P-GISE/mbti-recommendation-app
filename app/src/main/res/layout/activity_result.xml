<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 캡처할 영역 시작 -->
        <LinearLayout
            android:id="@+id/capture_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 헤더 -->
            <TextView
                android:id="@+id/tv_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- 결과 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 결과 아이콘 -->
                    <!-- <ImageView
                        android:id="@+id/iv_result_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_dialog_info"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="@string/content_description_result_icon" /> -->

                    <!-- 결과 제목 -->
                    <TextView
                        android:id="@+id/tv_result_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="당신에게 어울리는 야구구단"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <!-- 구단 이미지 (예시: LG 트윈스) -->
                    <ImageView
                        android:id="@+id/iv_team_logo"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/lg_twins"
                        android:contentDescription="구단 로고"
                        android:layout_marginBottom="8dp" />

                    <!-- 결과 부제목 -->
                    <TextView
                        android:id="@+id/tv_result_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="16sp"
                        android:textColor="@color/secondary_text"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- 궁합도 -->
                    <TextView
                        android:id="@+id/tv_compatibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- 결과 설명 -->
                    <TextView
                        android:id="@+id/tv_result_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:lineSpacingMultiplier="1.3"
                        android:gravity="center" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 상세 정보 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/detail_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 특성 제목 -->
                    <TextView
                        android:id="@+id/tv_characteristics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/characteristics"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_marginBottom="16dp" />

                    <!-- 특성 목록 -->
                    <LinearLayout
                        android:id="@+id/characteristics_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 앱 로고/워터마크 (스크린샷용) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/watermark_text"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:alpha="0.7" />

        </LinearLayout>
        <!-- 캡처할 영역 끝 -->

        <!-- 버튼 그룹 (캡처 영역 외부) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <!-- 상단 버튼 그룹 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- 스크린샷 버튼 -->
                <Button
                    android:id="@+id/btn_screenshot"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/screenshot"
                    android:textColor="@color/white"
                    android:background="@drawable/button_primary"
                    android:layout_marginEnd="4dp" />

                <!-- 공유 버튼 -->
                <Button
                    android:id="@+id/btn_share"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/share_result"
                    android:textColor="@color/white"
                    android:background="@drawable/button_primary"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- 중간 버튼 그룹 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- 상세보기 버튼 -->
                <Button
                    android:id="@+id/btn_detail"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/detail_view"
                    android:textColor="@color/white"
                    android:background="@drawable/button_primary"
                    android:layout_marginEnd="4dp" />

                <!-- 다시하기 버튼 -->
                <Button
                    android:id="@+id/btn_restart"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/restart"
                    android:textColor="@color/white"
                    android:background="@drawable/button_primary"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- 하단 버튼 -->
            <Button
                android:id="@+id/btn_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/go_home"
                android:textColor="@color/white"
                android:background="@drawable/button_primary" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>