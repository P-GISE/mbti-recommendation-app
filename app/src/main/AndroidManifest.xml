<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 결과 공유를 위한 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 스크린샷 저장을 위한 권한 (Android 12 이하) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 스크린샷 저장을 위한 권한 (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MBTI.NoActionBar"
        tools:targetApi="31">

        <!-- 메인 액티비티 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카테고리 선택 액티비티 -->
        <activity
            android:name=".CategoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity" />

        <!-- 질문 테스트 액티비티 -->
        <activity
            android:name=".QuestionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".CategoryActivity" />

        <!-- 결과 화면 액티비티 -->
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".QuestionActivity" />

        <!-- 상세 정보 액티비티 -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ResultActivity" />

        <!-- 파일 제공자 (스크린샷 공유용) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>